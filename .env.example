# Persistence adapter (#175/#176): local (default, device storage) | mock (in-memory) | supabase (mogmine_ tables).
NEXT_PUBLIC_PERSISTENCE_ADAPTER=local
# Supabase (#176), used only when NEXT_PUBLIC_PERSISTENCE_ADAPTER=supabase. Shared project showmob-dev (D-012).
# Browser-safe: the project URL and the anon / publishable key. Never put real values in this file.
# With supabase, /login gates the app (#182): magic link, implicit flow, allow-listed users only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only (never NEXT_PUBLIC_, never imported by browser code). Not used by the adapter.
SUPABASE_SERVICE_ROLE_KEY=
DEFAULT_OWNER_USER_ID=
# Opt-in, read-only live check in lib/__tests__/persistence-supabase-adapter.test.ts (skipped when empty).
MOGMINE_IT_SUPABASE_URL=
MOGMINE_IT_SUPABASE_ANON_KEY=
