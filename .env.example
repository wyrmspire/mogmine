# Copy this file to .env.local and fill in values yourself.
# Never commit .env.local, never paste keys into chat, and never put the
# service role key in a NEXT_PUBLIC_ variable (B-54).
#
# Leave these empty to keep the current Yahoo-only chart path. The app and
# `npm run archive:ingest` no-op the archive until both the URL and the
# service role key are set.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DEFAULT_OWNER_USER_ID=
